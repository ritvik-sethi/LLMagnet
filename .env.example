# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini citation probe (Score step) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Live Google search (preferred) — https://serper.dev
# SERPER_API_KEY=

# Or Google Programmable Search
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# X / Twitter recent search (optional) — https://developer.x.com
# TWITTER_BEARER_TOKEN=

NODE_ENV=development
